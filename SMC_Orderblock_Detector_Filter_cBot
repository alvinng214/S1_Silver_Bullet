        private Bars                    _sourceBars;
        private List<EntryObRecord>     _obRecords  = new List<EntryObRecord>();
        private List<EntryFvgRecord>    _fvgRecords = new List<EntryFvgRecord>();
        private EntrySignalState        _signal     = NewEmptyEntrySignal();
